  "skill": {
    "id": "skill_orange_left_tilt_drop",
    "name": "Pick orange, move left, tilt and drop",
    "version": "1.0.0",
    "status": "draft",
    "description": "Pick the orange screw, carry it 30 cm left and 20 cm down, tilt the wrist 30° to tip it, level again, then drop it in the delivery zone and go home.",
    "created_at": "2026-11-05T13:25:19Z",
    "updated_at": "2026-11-05T13:25:19Z",
    "source": {
      "type": "manual",
      "note": "Asked for 40 cm left / 35 cm down / drop anywhere by tilting; clamped to the cell limits: +Y ends at 0.40 m (30 cm left = y 0.38) and the arm holds the screw 30 cm above the table (20 cm down leaves ~5 cm clearance). The controller only releases a held object at a taught place target, so the drop is at the delivery zone. Tilt is wrist 1 +30° (60° would bring the screw to the table; the other way leaves the workspace). Verified step by step on URSim + PyBullet 2026-11-05."
    }
  },
