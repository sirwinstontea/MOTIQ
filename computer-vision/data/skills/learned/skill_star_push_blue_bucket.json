  "skill": {
    "id": "skill_star_push_blue_bucket",
    "name": "★ Push the blue bucket 5 cm forward (tested on real arm)",
    "version": "1.0.0",
    "status": "validated",
    "created_at": "2026-11-05T16:49:22Z",
    "updated_at": "2026-11-05T16:49:22Z",
    "description": "From the saved start pose: 20 cm down, the arm camera centres on the blue bucket, the gripper tip goes 12 cm behind the bucket centre, 30 cm down (tip below the rim), pushes 10 cm forward (5 cm gap + 5 cm push), lifts and returns to the start pose.",
    "source": {
      "type": "manual",
      "note": "Taught live on the real UR5e 2026-11-05 (operator: 'this is the exact movement I need'). Gripper 11 cm long. The camera looks forward at an angle: from 29 cm flange height the touch offset is 15 cm forward of the camera centre (computer-vision/data/calibration/touch_offset.json). Push depth: flange at -0.006 m (tip about 12 cm below the robot base)."
    }
  },
  "intent": {
    "goal": "Push the blue bucket 5 cm forward with the gripper tip.",
    "natural_language_instruction": "Go down behind the blue bucket and push it 5 cm forward.",
    "success_conditions": [
      "The blue bucket moved about 5 cm forward.",
      "The arm is back at its start pose."
    ]
  },
