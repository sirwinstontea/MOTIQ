# Copia questo file in .env e metti la tua chiave (setup.bat / setup.sh lo copiano da soli).
# Il file .env NON va committato (è in .gitignore).

# --- OpenRouter (finché non arriva la chiave xAI) ---
# Chiave OpenRouter (inizia con sk-or-...): https://openrouter.ai/keys
XAI_API_KEY=
XAI_BASE_URL=https://openrouter.ai/api/v1
XAI_MODEL=x-ai/grok-4.7

# --- Con la chiave xAI: metti la chiave xAI sopra e usa queste due righe al posto delle due sopra ---
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.7

# 1 = modalità finta, nessuna chiamata di rete (per provare senza chiave)
GROK_MOCK=0
# secondi massimi per chiamata a Grok, tentativi compresi (detect_objects: 10-13 s, a volte >20)
GROK_TIMEOUT=30
# quanto ragiona Grok: minimal (veloce), low, medium, high; vuoto = default del modello (lento, ~30-55 s)
GROK_REASONING=minimal
