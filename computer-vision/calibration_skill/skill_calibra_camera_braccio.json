  "skill": {
    "id": "arm_calibrate_camera",
    "name": "Calibrate arm camera",
    "version": "1.0.0",
    "status": "draft",
    "description": "Calibrates the wrist camera without touching the sheet. Before: ArUco sheet flat and still on the table, arm in the observation pose with the sheet in view, vision server started with --robot-ip. Takes 12 camera poses with small moves, solves, and ends with the fixed-pose calibration. The vision server never moves the robot: only the app's small steps do.",
    "created_at": "2026-11-05T00:00:00Z",
    "updated_at": "2026-11-05T00:00:00Z"
  },
  "intent": {
    "goal": "Calibrate the arm camera.",
    "natural_language_instruction": "Calibrate the arm camera from the ArUco sheet.",
    "success_conditions": [
      "hand_eye.json, markers_mm.json and fixed_pose.json are written.",
      "The arm is back in the observation pose."
    ]
  },
  "robot": {
    "device": "arm",
    "model": "Universal Robots UR5e"
  },
  "environment": {
    "coordinate_system": "world",
    "units": "meters",
