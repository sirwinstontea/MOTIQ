# Copy to .env and fill in. Restart `npx expo start -c` after changing.

# Should return the body of POST https://api.x.ai/v1/realtime/client_secrets
EXPO_PUBLIC_TOKEN_URL=

# Dev fallback only - this ends up inside the JS bundle.
EXPO_PUBLIC_XAI_API_KEY=

EXPO_PUBLIC_GROK_VOICE_MODEL=grok-voice-latest
EXPO_PUBLIC_GROK_VOICE=eve

EXPO_PUBLIC_DOG_URL=
EXPO_PUBLIC_ARM_URL=

# Shared secret sent as X-Bridge-Key to the bridges
EXPO_PUBLIC_BRIDGE_KEY=

# Grok vision (camera -> "what do you see"). Uses the xAI key above unless VISION_URL points to our backend proxy.
EXPO_PUBLIC_GROK_VISION_MODEL=grok-4.7
EXPO_PUBLIC_VISION_URL=

# Extra cameras: Name=url pairs, comma separated. Each url must return a single JPEG.
# Robot bridges get <bridge>/camera.jpg automatically. Android "IP Webcam" app works: http://<phone-ip>:8080/shot.jpg
EXPO_PUBLIC_CAMERAS=
