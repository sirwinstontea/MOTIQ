{
  "schema_version": "1.1.0",

  "skill": {
    "id": "skill_pick_place_001",
    "name": "Pick red cube and place in blue box",
    "version": "1.1.0",
    "status": "draft",

    "description": "Find a red cube, pick it up and place it inside a blue box while keeping it upright. Executed by a UR5e arm using the action primitives listed in 'action_primitives'.",

    "created_at": "2026-11-04T10:00:00Z",
    "updated_at": "2026-11-04T15:00:00Z",

    "source": {
      "demonstration_id": "demo_001",
      "video": "assets/demo_001/video.mp4",
      "audio": "assets/demo_001/audio.wav",
      "transcript": "assets/demo_001/transcript.json",
      "frames_directory": "assets/demo_001/frames/"
    }
  },

  "intent": {
    "goal": "Place the red cube inside the blue box.",
    "natural_language_instruction": "Pick up the red cube and put it inside the blue box. Keep it upright.",

    "success_conditions": [
      "The red cube is inside the blue box.",
      "The cube remains upright.",
      "The robot releases the cube.",
      "The cube remains stable after release."
    ]
  },

  "robot": {
    "model": "Universal Robots UR5e",
    "degrees_of_freedom": 6,
    "payload_kg": 5.0,
    "reach_m": 0.85,
    "pose_repeatability_m": 0.00003,
    "max_tcp_speed_mps": 1.0,
    "controller_language": "URScript",
    "angle_units_in_skill": "degrees (convert to radians for URScript)",

    "joints": [
      { "index": 0, "id": "shoulder_pan_joint",  "name_it": "base",    "motion": "rotates the whole arm around the vertical axis", "range_deg": [-360, 360], "max_speed_dps": 180 },
      { "index": 1, "id": "shoulder_lift_joint", "name_it": "spalla",  "motion": "raises / lowers the upper arm",                   "range_deg": [-360, 360], "max_speed_dps": 180 },
      { "index": 2, "id": "elbow_joint",         "name_it": "gomito",  "motion": "bends / extends the forearm",                    "range_deg": [-360, 360], "max_speed_dps": 180, "note": "ROS ur_description limits it to [-180, 180] to avoid self-collision" },
      { "index": 3, "id": "wrist_1_joint",       "name_it": "polso 1", "motion": "tilts the wrist (pitch)",                        "range_deg": [-360, 360], "max_speed_dps": 180 },
      { "index": 4, "id": "wrist_2_joint",       "name_it": "polso 2", "motion": "turns the wrist sideways (yaw)",                 "range_deg": [-360, 360], "max_speed_dps": 180 },
      { "index": 5, "id": "wrist_3_joint",       "name_it": "polso 3", "motion": "spins the flange / gripper (roll)",              "range_deg": [-360, 360], "max_speed_dps": 180 }
    ],

    "cartesian_dof": {
      "frame": "base",
      "pose_format": "p[x, y, z, rx, ry, rz] (meters + rotation vector in radians)",
      "translations": ["x", "y", "z"],
      "rotations": ["rx", "ry", "rz"]
    },

    "direction_mapping": {
      "reference": "Operator standing behind the robot base, looking towards +X. Must be checked on the real cell with the teach pendant: sign and axis depend on how the base is mounted.",
      "calibrated": false,
      "forward":  { "axis": "x", "sign": 1 },
      "backward": { "axis": "x", "sign": -1 },
      "left":     { "axis": "y", "sign": 1 },
      "right":    { "axis": "y", "sign": -1 },
      "up":       { "axis": "z", "sign": 1 },
      "down":     { "axis": "z", "sign": -1 }
    },

    "gripper": {
      "model": "TO_BE_CONFIRMED (e.g. Robotiq 2F-85)",
      "stroke_m": 0.085,
      "open_command_urscript": "rq_open()  |  I/O gripper: set_tool_digital_out(0, False)",
      "close_command_urscript": "rq_close()  |  I/O gripper: set_tool_digital_out(0, True)",
      "object_detection": "Robotiq: rq_is_object_detected()"
    },

    "home_joints_deg": [0, -90, 90, -90, -90, 0],

    "operational_limits": {
      "max_tcp_speed_mps": 0.25,
      "max_tcp_acceleration_mps2": 0.5,
      "max_joint_speed_dps": 60,
      "approach_speed_mps": 0.05,
      "min_z_above_table_m": 0.01,
      "safe_travel_height_m": 0.15,
      "default_step_m": 0.05,
      "max_step_m": 0.20,
      "default_rotation_step_deg": 15,
      "max_rotation_step_deg": 90,
      "note": "Demo values, tune on the real cell. Hard safety limits stay in the UR safety configuration."
    }
  },

  "action_primitives": [
    {
      "id": "OPEN_GRIPPER",
      "voice_aliases_it": ["apri pinza", "apri la pinza", "rilascia", "lascia"],
      "description": "Open the gripper fully (or to a given width).",
      "parameters": { "width_m": { "type": "number", "default": 0.085, "min": 0.0, "max": 0.085 } },
      "urscript": "rq_open()"
    },
    {
      "id": "CLOSE_GRIPPER",
      "voice_aliases_it": ["chiudi pinza", "chiudi la pinza", "prendi", "afferra"],
      "description": "Close the gripper until contact or until fully closed.",
      "parameters": { "force_pct": { "type": "number", "default": 70, "min": 0, "max": 100 } },
      "postconditions": ["Gripper reports object detected, otherwise grasp failed."],
      "urscript": "rq_close()"
    },

    {
      "id": "MOVE_RIGHT",
      "voice_aliases_it": ["muovi destra", "vai a destra", "destra"],
      "description": "Linear move of the TCP to the right, orientation unchanged.",
      "direction": "right",
      "parameters": { "distance_m": { "type": "number", "default": 0.05, "max": 0.20 }, "speed_mps": { "type": "number", "default": 0.1 } },
      "urscript": "movel(pose_add(get_actual_tcp_pose(), p[0, -d, 0, 0, 0, 0]), a=0.5, v=speed)"
    },
    {
      "id": "MOVE_LEFT",
      "voice_aliases_it": ["muovi sinistra", "vai a sinistra", "sinistra"],
      "description": "Linear move of the TCP to the left, orientation unchanged.",
      "direction": "left",
      "parameters": { "distance_m": { "type": "number", "default": 0.05, "max": 0.20 }, "speed_mps": { "type": "number", "default": 0.1 } },
      "urscript": "movel(pose_add(get_actual_tcp_pose(), p[0, d, 0, 0, 0, 0]), a=0.5, v=speed)"
    },
    {
      "id": "MOVE_FORWARD",
      "voice_aliases_it": ["muovi avanti", "vai avanti", "avanti"],
      "description": "Linear move of the TCP forward (away from the base).",
      "direction": "forward",
      "parameters": { "distance_m": { "type": "number", "default": 0.05, "max": 0.20 }, "speed_mps": { "type": "number", "default": 0.1 } },
      "urscript": "movel(pose_add(get_actual_tcp_pose(), p[d, 0, 0, 0, 0, 0]), a=0.5, v=speed)"
    },
    {
      "id": "MOVE_BACKWARD",
      "voice_aliases_it": ["muovi indietro", "vai indietro", "indietro"],
      "description": "Linear move of the TCP backward (towards the base).",
      "direction": "backward",
      "parameters": { "distance_m": { "type": "number", "default": 0.05, "max": 0.20 }, "speed_mps": { "type": "number", "default": 0.1 } },
      "urscript": "movel(pose_add(get_actual_tcp_pose(), p[-d, 0, 0, 0, 0, 0]), a=0.5, v=speed)"
    },
    {
      "id": "MOVE_UP",
      "voice_aliases_it": ["muovi su", "sali", "alza", "su"],
      "description": "Vertical linear move up.",
      "direction": "up",
      "parameters": { "distance_m": { "type": "number", "default": 0.05, "max": 0.20 }, "speed_mps": { "type": "number", "default": 0.1 } },
      "urscript": "movel(pose_add(get_actual_tcp_pose(), p[0, 0, d, 0, 0, 0]), a=0.5, v=speed)"
    },
    {
      "id": "MOVE_DOWN",
      "voice_aliases_it": ["muovi giu", "scendi", "abbassa", "giu"],
      "description": "Vertical linear move down. Refused if the target z is below min_z_above_table_m.",
      "direction": "down",
      "parameters": { "distance_m": { "type": "number", "default": 0.05, "max": 0.20 }, "speed_mps": { "type": "number", "default": 0.05 } },
      "urscript": "movel(pose_add(get_actual_tcp_pose(), p[0, 0, -d, 0, 0, 0]), a=0.5, v=speed)"
    },

    {
      "id": "ROTATE_ROLL",
      "voice_aliases_it": ["inclina pinza a destra", "inclina pinza a sinistra"],
      "description": "Rotate the tool around its own X axis (TCP frame). Positive = counter-clockwise (right-hand rule).",
      "parameters": { "angle_deg": { "type": "number", "default": 15, "min": -90, "max": 90 } },
      "urscript": "movel(pose_trans(get_actual_tcp_pose(), p[0, 0, 0, d2r(angle), 0, 0]), a=0.5, v=0.1)"
    },
    {
      "id": "ROTATE_PITCH",
      "voice_aliases_it": ["inclina pinza avanti", "inclina pinza indietro"],
      "description": "Rotate the tool around its own Y axis (TCP frame).",
      "parameters": { "angle_deg": { "type": "number", "default": 15, "min": -90, "max": 90 } },
      "urscript": "movel(pose_trans(get_actual_tcp_pose(), p[0, 0, 0, 0, d2r(angle), 0]), a=0.5, v=0.1)"
    },
    {
      "id": "ROTATE_YAW",
      "voice_aliases_it": ["ruota pinza", "ruota pinza orario", "ruota pinza antiorario"],
      "description": "Rotate the tool around its own Z axis (spin the gripper). Clockwise = negative angle.",
      "parameters": { "angle_deg": { "type": "number", "default": 15, "min": -90, "max": 90 } },
      "urscript": "movel(pose_trans(get_actual_tcp_pose(), p[0, 0, 0, 0, 0, d2r(angle)]), a=0.5, v=0.1)"
    },

    {
      "id": "MOVE_JOINT",
      "voice_aliases_it": ["ruota base", "muovi spalla", "muovi gomito", "muovi polso 1", "muovi polso 2", "muovi polso 3"],
      "description": "Move a single joint by a relative angle (or to an absolute angle). Covers all 6 DOF in joint space.",
      "parameters": {
        "joint": { "type": "enum", "values": ["shoulder_pan_joint", "shoulder_lift_joint", "elbow_joint", "wrist_1_joint", "wrist_2_joint", "wrist_3_joint"] },
        "delta_deg": { "type": "number", "default": 10, "min": -90, "max": 90 },
        "target_deg": { "type": "number", "optional": true, "note": "If set, overrides delta_deg." },
        "speed_dps": { "type": "number", "default": 30 }
      },
      "urscript": "q = get_actual_joint_positions()  q[i] = q[i] + d2r(delta)  movej(q, a=1.0, v=d2r(speed))"
    },
    {
      "id": "MOVE_JOINTS",
      "voice_aliases_it": [],
      "description": "Move all 6 joints to absolute angles.",
      "parameters": { "joints_deg": { "type": "array", "items": "number", "length": 6 }, "speed_dps": { "type": "number", "default": 30 } },
      "urscript": "movej([q0, q1, q2, q3, q4, q5], a=1.0, v=d2r(speed))"
    },
    {
      "id": "MOVE_TO_POSE",
      "voice_aliases_it": ["vai a"],
      "description": "Linear move of the TCP to an absolute Cartesian pose in the base frame (all 6 Cartesian DOF).",
      "parameters": {
        "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" },
        "rx": { "type": "number", "optional": true }, "ry": { "type": "number", "optional": true }, "rz": { "type": "number", "optional": true },
        "speed_mps": { "type": "number", "default": 0.1 }
      },
      "note": "Missing rx/ry/rz = keep current orientation. Rotation is a rotation vector in radians.",
      "urscript": "movel(p[x, y, z, rx, ry, rz], a=0.5, v=speed)"
    },
    {
      "id": "MOVE_ABOVE",
      "voice_aliases_it": ["vai sopra"],
      "description": "Move at safe_travel_height_m above a detected object, orientation unchanged. Always lift before traveling horizontally.",
      "parameters": { "target": { "type": "object_id" }, "height_m": { "type": "number", "default": 0.15 } },
      "urscript": "movel(p[obj.x, obj.y, obj.z + h, rx, ry, rz], a=0.5, v=0.2)"
    },
    {
      "id": "HOME",
      "voice_aliases_it": ["torna a casa", "home", "posizione iniziale"],
      "description": "Joint move to robot.home_joints_deg (tool pointing down).",
      "parameters": {},
      "urscript": "movej([0, -1.571, 1.571, -1.571, -1.571, 0], a=1.0, v=0.5)"
    },
    {
      "id": "STOP",
      "voice_aliases_it": ["stop", "fermati", "ferma", "basta"],
      "description": "Decelerate and stop the current motion. Highest priority, interrupts any running step.",
      "parameters": {},
      "urscript": "stopl(2.0)"
    },
    {
      "id": "WAIT",
      "voice_aliases_it": ["aspetta"],
      "description": "Pause for settling.",
      "parameters": { "seconds": { "type": "number", "default": 0.5, "max": 10 } },
      "urscript": "sleep(seconds)"
    }
  ],

  "environment": {
    "coordinate_system": "world",
    "units": "meters",

    "workspace": {
      "type": "tabletop",
      "surface": "table"
    },

    "objects": [
      {
        "id": "object_cube",
        "name": "red cube",
        "category": "cube",
        "attributes": {
          "color": "red",
          "shape": "cube"
        },
        "initial_state": {
          "location": {
            "x": 0.30,
            "y": 0.15,
            "z": 0.02
          },
          "orientation": {
            "type": "upright"
          }
        },
        "detection": {
          "required": true,
          "class": "cube",
          "reidentify_before_pick": true
        }
      },
      {
        "id": "object_box",
        "name": "blue box",
        "category": "container",
        "attributes": {
          "color": "blue",
          "shape": "box"
        },
        "initial_state": {
          "location": {
            "x": 0.55,
            "y": 0.10,
            "z": 0.0
          }
        },
        "detection": {
          "required": true,
          "class": "container",
          "reidentify_before_place": true
        }
      }
    ]
  },

  "constraints": {
    "object_constraints": [
      {
        "type": "orientation",
        "object": "object_cube",
        "required_value": "upright"
      },
      {
        "type": "containment",
        "object": "object_cube",
        "container": "object_box"
      }
    ],

    "execution_constraints": {
      "collision_avoidance": true,
      "require_object_reidentification": true,
      "require_workspace_validation": true,
      "require_grasp_validation": true,
      "allow_adaptive_replanning": true,
      "open_gripper_before_descending": true,
      "lift_before_horizontal_travel": true,
      "respect_operational_limits": true
    }
  },

  "steps": [
    {
      "id": "step_001",
      "action": "DETECT",
      "target": "object_cube",
      "description": "Locate and identify the red cube.",
      "preconditions": [
        "Camera is operational.",
        "Workspace is visible."
      ],
      "postconditions": [
        "Red cube is detected.",
        "Cube position is available."
      ],
      "failure_policy": "STOP_AND_REOBSERVE"
    },
    {
      "id": "step_002",
      "action": "PICK",
      "target": "object_cube",
      "description": "Grasp the red cube without changing its upright orientation.",
      "parameters": {
        "grasp_type": "top_grasp",
        "preserve_orientation": true
      },
      "primitive_sequence": [
        { "primitive": "OPEN_GRIPPER" },
        { "primitive": "MOVE_ABOVE", "parameters": { "target": "object_cube", "height_m": 0.15 } },
        { "primitive": "MOVE_DOWN", "parameters": { "distance_m": 0.13, "speed_mps": 0.05 } },
        { "primitive": "CLOSE_GRIPPER", "parameters": { "force_pct": 70 } },
        { "primitive": "MOVE_UP", "parameters": { "distance_m": 0.13 } }
      ],
      "preconditions": [
        "Red cube is detected.",
        "Grasp pose is validated.",
        "Robot reachability is confirmed."
      ],
      "postconditions": [
        "Cube is attached to gripper.",
        "Grasp is verified."
      ],
      "failure_policy": "RETRY_WITH_REOBSERVATION"
    },
    {
      "id": "step_003",
      "action": "PLACE",
      "target": "object_box",
      "description": "Place the cube inside the blue box.",
      "parameters": {
        "placement_mode": "inside_container",
        "preserve_orientation": true,
        "release_after_placement": true
      },
      "primitive_sequence": [
        { "primitive": "MOVE_ABOVE", "parameters": { "target": "object_box", "height_m": 0.15 } },
        { "primitive": "MOVE_DOWN", "parameters": { "distance_m": 0.08, "speed_mps": 0.05 } },
        { "primitive": "OPEN_GRIPPER" },
        { "primitive": "MOVE_UP", "parameters": { "distance_m": 0.08 } },
        { "primitive": "HOME" }
      ],
      "preconditions": [
        "Cube is securely grasped.",
        "Blue box is detected.",
        "Placement area is validated."
      ],
      "postconditions": [
        "Cube is released inside the box."
      ],
      "failure_policy": "STOP_AND_REPLAN"
    },
    {
      "id": "step_004",
      "action": "VERIFY",
      "target": "object_cube",
      "description": "Check that the cube is inside the blue box and upright.",
      "parameters": {
        "check_containment": true,
        "check_orientation": true,
        "check_stability": true
      },
      "success_conditions": [
        "Cube is inside box.",
        "Cube is upright.",
        "Cube is stable.",
        "Gripper is no longer holding cube."
      ],
      "failure_policy": "REPORT_FAILURE"
    }
  ],

  "success_criteria": {
    "all_steps_completed": true,
    "object_placement_verified": true,
    "orientation_verified": true,
    "stability_verified": true
  },

